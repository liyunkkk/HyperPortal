<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF73B4FF"
                android:endColor="#FF347BE4" />
            <stroke
                android:width="1dp"
                android:color="#D9FFFFFF" />
            <padding
                android:bottom="6dp"
                android:left="7dp"
                android:right="7dp"
                android:top="6dp" />
        </shape>
    </item>
    <item
        android:height="5dp"
        android:gravity="top"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
