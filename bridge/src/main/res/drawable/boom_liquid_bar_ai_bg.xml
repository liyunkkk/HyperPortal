<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FF73B4FF"
                android:endColor="#FF347BE4" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#91F4F9FF"
                android:endColor="#73B4FFFF" />
            <stroke android:width="1dp" android:color="#A6FFFFFF" />
        </shape>
    </item>
</selector>
